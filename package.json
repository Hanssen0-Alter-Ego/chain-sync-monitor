{
  "name": "chain-sync-monitor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "tsc -p frontend/tsconfig.json && node frontend/build.mjs",
    "start": "node dist/server/backend/src/index.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": { "smol-toml": "1.6.0" },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
